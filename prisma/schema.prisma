datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  walletAddress String?        @unique
  email         String?        @unique
  mobileNumber  String?        @unique
  googleId      String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       Profile?
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String   @unique
  displayName   String
  nickname      String   @default("")
  bio           String   @default("")
  avatarUrl     String   @default("")
  bannerUrl     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Post {
  id            String               @id @default(uuid())
  authorAddress String
  caption       String
  mediaUrl      String
  mediaCid      String               @default("")
  mediaType     String               @default("image") // image | video
  location      String               @default("")
  privacy       String               @default("public") // public | private | followers
  likeCount     Int                  @default(0)
  commentCount  Int                  @default(0)
  shareCount    Int                  @default(0)
  viewsCount    Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  comments      Comment[]
  likes         Like[]
  shares        Share[]
  views         View[]
  analytics     Analytics?
  savedPosts    SavedPost[]

  @@index([authorAddress])
  @@index([createdAt])
}

model Comment {
  id            String   @id @default(uuid())
  postId        String?
  post          Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  pulseId       String?
  pulse         Pulse?   @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  authorAddress String
  content       String
  createdAt     DateTime @default(now())

  @@index([postId])
  @@index([pulseId])
}

model Like {
  id          String   @id @default(uuid())
  postId      String?
  post        Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  pulseId     String?
  pulse       Pulse?   @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  userAddress String
  createdAt   DateTime @default(now())

  @@unique([postId, userAddress])
  @@unique([pulseId, userAddress])
}

model Follow {
  id               String   @id @default(uuid())
  followerAddress  String
  followingAddress String
  createdAt        DateTime @default(now())

  @@unique([followerAddress, followingAddress])
  @@index([followerAddress])
  @@index([followingAddress])
}

model Notification {
  id               String   @id @default(uuid())
  recipientAddress String
  senderAddress    String
  type             String   // LIKE | COMMENT | FOLLOW | MENTION
  title            String
  message          String
  link             String   @default("")
  read             Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([recipientAddress])
}

model Media {
  id        String   @id @default(uuid())
  cid       String   @unique
  url       String
  fileType  String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
}

model Hashtag {
  id        String   @id @default(uuid())
  tag       String   @unique
  postCount Int      @default(1)
  createdAt DateTime @default(now())
}

model Pulse {
  id                  String   @id @default(uuid())
  authorAddress       String
  videoUrl            String
  videoCid            String   @default("")
  thumbnailUrl        String   @default("")
  caption             String
  hashtags            String   @default("")
  category            String   @default("Tech")
  audioTitle          String   @default("Original Sound")
  audioId             String?
  audio               Audio?   @relation(fields: [audioId], references: [id])
  filterName          String?  @default("")
  location            String   @default("")
  privacy             String   @default("Everyone") // Everyone | Followers | Close Friends
  allowComments       Boolean  @default(true)
  allowRemix          Boolean  @default(true)
  allowDownload       Boolean  @default(true)
  viewsCount          Int      @default(0)
  likeCount           Int      @default(0)
  commentCount        Int      @default(0)
  shareCount          Int      @default(0)
  saveCount           Int      @default(0)
  pulseScore          Int      @default(85)
  authenticScore      Int      @default(94)
  remixOfId           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  comments            Comment[]
  likes               Like[]
  shares              Share[]
  views               View[]
  analytics           Analytics?
  savedPulses         SavedPulse[]

  @@index([authorAddress])
  @@index([pulseScore])
}

model SavedPulse {
  id          String   @id @default(uuid())
  userAddress String
  pulseId     String
  pulse       Pulse    @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  folder      String   @default("All")
  createdAt   DateTime @default(now())

  @@unique([userAddress, pulseId])
  @@index([userAddress])
  @@index([pulseId])
}

model UserSettings {
  id                      String   @id @default(uuid())
  walletAddress           String   @unique
  privateAccount          Boolean  @default(false)
  whoCanFollow            String   @default("everyone")
  whoCanMessage           String   @default("everyone")
  whoCanMention           String   @default("everyone")
  whoCanTag               String   @default("everyone")
  storyPrivacy            String   @default("everyone")
  closeFriends            String   @default("")
  activityStatus          Boolean  @default(true)
  readReceipts            Boolean  @default(true)
  allowDownloads          Boolean  @default(true)
  allowRemix              Boolean  @default(true)
  twoFactorEnabled        Boolean  @default(false)
  muteAllNotifications    Boolean  @default(false)
  muteDuration            String   @default("off")
  notificationLikes       Boolean  @default(true)
  notificationComments    Boolean  @default(true)
  notificationFollows     Boolean  @default(true)
  notificationMessages    Boolean  @default(true)
  notificationMentions    Boolean  @default(true)
  notificationTags        Boolean  @default(true)
  notificationPulse       Boolean  @default(true)
  notificationLive        Boolean  @default(true)
  notificationDevelopment Boolean  @default(true)
  notificationCreator     Boolean  @default(true)
  notificationSecurity    Boolean  @default(true)
  notificationPush        Boolean  @default(true)
  sensitiveContent        String   @default("standard")
  hiddenWords             String   @default("")
  contentLanguage         String   @default("English")
  autoplay                Boolean  @default(true)
  videoQuality            String   @default("auto")
  creatorModeEnabled      Boolean  @default(false)
  theme                   String   @default("dark") // dark | light | system
  reducedMotion           Boolean  @default(false)
  dataSaver               Boolean  @default(false)
  trendingNotifications   Boolean  @default(true)
  aiSuggestions           Boolean  @default(true)
  trendAlerts             Boolean  @default(true)
  opportunityAlerts       Boolean  @default(true)
  interests               String   @default("") // Comma-separated selected interests: Bollywood, Punjabi, Haryanvi, Rajasthani, Hindi, English, Comedy, Travel, Gaming, Sports, Fashion, Fitness, Technology, Motivation, Education, Food, Memes, Lifestyle
  favoriteGenres          String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model BlockedAccount {
  id             String   @id @default(uuid())
  blockerAddress String
  blockedAddress String
  type           String   @default("block") // block | restrict | mute
  createdAt      DateTime @default(now())

  @@unique([blockerAddress, blockedAddress, type])
  @@index([blockerAddress])
}

model UserSession {
  id            String   @id @default(uuid())
  walletAddress String
  deviceName    String
  location      String
  ipAddress     String   @default("127.0.0.1")
  isCurrent     Boolean  @default(false)
  lastActive    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([walletAddress])
}

model Story {
  id            String      @id @default(uuid())
  authorAddress String
  mediaUrl      String?
  mediaType     String      // image | video | text
  textContent   String?
  textBgColor   String?     @default("#121212")
  audioTitle    String?
  audioUrl      String?
  privacy       String      @default("everyone") // everyone | followers | close_friends
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
  views         StoryView[]

  @@index([authorAddress])
  @@index([expiresAt])
}

model Share {
  id          String   @id @default(uuid())
  userAddress String
  postId      String?
  post        Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  pulseId     String?
  pulse       Pulse?   @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userAddress])
}

model Audio {
  id           String   @id @default(uuid())
  title        String
  artist       String   @default("Original Artist")
  url          String
  duration     Int      @default(30)
  thumbnailUrl String   @default("")
  category     String   @default("Bollywood") // Bollywood | Punjabi | Haryanvi | Rajasthani | Hindi | English | Instrumental | Trending
  language     String   @default("Hindi")
  useCount     Int      @default(0)
  trendGrowth  Float    @default(0.0)
  status       String   @default("trending") // trending | rising | popular
  createdAt    DateTime @default(now())
  pulses       Pulse[]
}

model Filter {
  id          String   @id @default(uuid())
  name        String
  category    String   // Trending | Beauty | Cinematic | Vintage | Retro | Glow | AI | Funny | Anime | Black & White | Aesthetic
  previewUrl  String   @default("")
  isTrending  Boolean  @default(false)
  useCount    Int      @default(0)
  createdAt   DateTime @default(now())
}

model View {
  id          String   @id @default(uuid())
  userAddress String?
  postId      String?
  post        Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  pulseId     String?
  pulse       Pulse?   @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userAddress])
}

model Analytics {
  id            String   @id @default(uuid())
  pulseId       String?  @unique
  pulse         Pulse?   @relation(fields: [pulseId], references: [id], onDelete: Cascade)
  postId        String?  @unique
  post          Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewsCount    Int      @default(0)
  likesCount    Int      @default(0)
  sharesCount   Int      @default(0)
  savesCount    Int      @default(0)
  commentsCount Int      @default(0)
  trendScore    Float    @default(0.0)
  updatedAt     DateTime @updatedAt
}

model TrendingContent {
  id          String   @id @default(uuid())
  type        String   // REEL | HASHTAG | CREATOR | AUDIO | FILTER
  targetId    String
  score       Float
  rank        Int
  createdAt   DateTime @default(now())
}

model OtpVerification {
  id           String   @id @default(uuid())
  mobileNumber String   @unique
  otpHash      String
  expiresAt    DateTime
  attempts     Int      @default(0)
  requestedAt  DateTime @default(now())
}

model SavedPost {
  id            String   @id @default(uuid())
  userAddress   String
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([userAddress, postId])
  @@index([userAddress])
  @@index([postId])
}

model StoryView {
  id            String   @id @default(uuid())
  storyId       String
  story         Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerAddress String
  viewedAt      DateTime @default(now())

  @@unique([storyId, viewerAddress])
  @@index([storyId])
  @@index([viewerAddress])
}

model Conversation {
  id        String               @id @default(uuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userAddress    String
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userAddress])
  @@index([conversationId])
  @@index([userAddress])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderAddress  String
  content        String
  read           Boolean      @default(false)
  deletedBy      String       @default("") // Comma-separated user addresses who deleted this message for themselves
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderAddress])
  @@index([createdAt])
}

model Report {
  id              String   @id @default(uuid())
  reporterAddress String
  targetType      String   // POST | PULSE | PROFILE | COMMENT
  targetId        String
  reason          String
  createdAt       DateTime @default(now())

  @@index([reporterAddress])
  @@index([targetId])
}

model Snap {
  id              String    @id @default(uuid())
  senderAddress   String
  receiverAddress String
  mediaUrl        String
  mediaType       String    @default("image") // image | video
  caption         String?
  duration        Int       @default(6) // seconds
  isOpened        Boolean   @default(false)
  openedAt        DateTime?
  createdAt       DateTime  @default(now())

  @@index([senderAddress])
  @@index([receiverAddress])
  @@index([createdAt])
}

model Streak {
  id                    String    @id @default(uuid())
  user1Address          String
  user2Address          String
  currentStreak         Int       @default(0)
  lastUser1SnapAt       DateTime?
  lastUser2SnapAt       DateTime?
  lastStreakIncrementAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([user1Address, user2Address])
  @@index([user1Address])
  @@index([user2Address])
}

model HiringListing {
  id               String          @id @default(uuid())
  userAddress      String          @unique
  fullName         String
  email            String
  phone            String
  creatorType      String          // Video Creator | Influencer | Photographer | Developer | Model | Designer | Musician | Brand | Editor | Freelancer
  listingType      String          @default("promotion") // promotion | hiring
  category         String          @default("General") // Fashion | Tech | Comedy | Music | Travel | Fitness | Education | Food | Lifestyle | Gaming
  location         String          @default("Jaipur, India")
  isOpenForCollab  Boolean         @default(true)
  startingPrice    Int             @default(1000)
  services         String          @default("Story Promotion, Reel Promotion, Product Review, Brand Collaboration")
  packages         String          @default("[{\"name\":\"Story\",\"price\":500},{\"name\":\"Post\",\"price\":1000},{\"name\":\"Reel\",\"price\":2000},{\"name\":\"Product Review\",\"price\":3000}]")
  isNegotiable     Boolean         @default(true)
  description      String
  requests         HiringRequest[]
  savedBy          SavedCreator[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userAddress])
  @@index([creatorType])
  @@index([listingType])
  @@index([location])
  @@index([isOpenForCollab])
}

model HiringRequest {
  id            String        @id @default(uuid())
  listingId     String
  listing       HiringListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  senderAddress String
  senderName    String
  senderEmail   String
  senderPhone   String
  service       String        @default("Brand Collaboration")
  budget        Int           @default(2000)
  deadline      String        @default("Within 7 days")
  message       String
  status        String        @default("pending") // pending | accepted | rejected | completed
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([listingId])
  @@index([senderAddress])
  @@index([status])
}

model SavedCreator {
  id             String        @id @default(uuid())
  userAddress    String
  listingId      String
  listing        HiringListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([userAddress, listingId])
  @@index([userAddress])
  @@index([listingId])
}

model Deal {
  id               String         @id @default(uuid())
  creatorAddress   String
  clientAddress    String
  service          String
  price            Int
  deliverables     String
  deadline         String
  description      String
  status           String         @default("request") // request | negotiation | accepted | content_pending | review | completed | cancelled
  currentOfferBy   String         @default("client") // client | creator
  termsLocked      Boolean        @default(false)
  deliverableUrl   String         @default("")
  deliverableNotes String         @default("")
  timelineUpdates  String         @default("[]") // JSON log of status and counter-offer history
  reviews          CollabReview[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([creatorAddress])
  @@index([clientAddress])
  @@index([status])
}

model CollabReview {
  id              String   @id @default(uuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reviewerAddress String
  targetAddress   String
  reviewerName    String   @default("Client")
  rating          Int      @default(5) // 1 to 5
  reviewText      String
  createdAt       DateTime @default(now())

  @@index([dealId])
  @@index([targetAddress])
  @@index([reviewerAddress])
}




