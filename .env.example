# ==============================================================================
# Aura Social Network - Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Standard PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler URL (Port 6543) - Recommended for Vercel Serverless
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct PostgreSQL Connection (Port 5432) - Used for migrations & Prisma CLI
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (Required)
JWT_SECRET="aura_social_secure_jwt_secret_2026"

# ------------------------------------------------------------------------------
# 3. REAL SMS OTP DELIVERY PROVIDERS (Configure at least one)
# ------------------------------------------------------------------------------
# OPTION A: Twilio (Global SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="" # e.g. +1234567890 or Messaging Service SID MGxxxx

# OPTION B: MSG91 (Cost-effective SMS in India)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# OPTION C: Fast2SMS (India Quick SMS)
FAST2SMS_API_KEY=""

# ------------------------------------------------------------------------------
# 4. REAL EMAIL OTP DELIVERY PROVIDERS (Configure at least one)
# ------------------------------------------------------------------------------
# OPTION A: Resend (Recommended for Next.js / Vercel)
RESEND_API_KEY=""
EMAIL_FROM="Aura <onboarding@resend.dev>" # or custom domain e.g. Aura <noreply@yourdomain.com>

# OPTION B: SendGrid
SENDGRID_API_KEY=""
SENDGRID_FROM="noreply@yourdomain.com"

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-project.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="" # Optional override; defaults automatically to {origin}/api/auth/google/callback

# ------------------------------------------------------------------------------
# 6. IPFS & MEDIA STORAGE (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs/"

# ------------------------------------------------------------------------------
# 7. FIREBASE CLIENT SDK CONFIGURATION (Optional fallback)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
